# Copy to .env and adjust as needed. Every variable is optional --
# the values below are the defaults (see app/core/config.py).

# -- Application --------------------------------------------------------
# QAROR_APP_NAME="Qaror 234 RAG API"
# QAROR_ENVIRONMENT=local            # local | staging | production

# -- LLM (Ollama) -------------------------------------------------------
# QAROR_OLLAMA_BASE_URL=http://localhost:11434
# QAROR_OLLAMA_MODEL=qwen2.5:7b-instruct
# How long Ollama keeps the model in RAM after a request ('30m', '1h30m',
# '0' to unload immediately, '-1s' to keep it loaded indefinitely). Leave
# empty to send nothing and defer to the Ollama server's own policy --
# the right choice when that server is shared with other tools.
# QAROR_OLLAMA_KEEP_ALIVE=30m
# QAROR_LLM_TEMPERATURE=0.1
# QAROR_LLM_TIMEOUT_SECONDS=120
# Answers shorter than this (e.g. a bare "25") trigger one follow-up
# request asking the model to restate them as a full sentence.
# QAROR_LLM_MIN_ANSWER_CHARS=20

# -- Ingestion / chunking -----------------------------------------------
# Applied when the index is built -- change these, then re-run `make ingest`.
# Rough token estimate: ~4 chars per token for uz/ru/en mixed text.
# QAROR_CHUNK_MAX_CHARS=1800
# QAROR_CHUNK_OVERLAP_CHARS=250
# Chroma collection name -- must match between ingestion and serving.
# QAROR_COLLECTION_NAME=qaror_234

# -- Retrieval ----------------------------------------------------------
# QAROR_EMBEDDING_MODEL=BAAI/bge-m3
# QAROR_TOP_K=5
# QAROR_SCORE_THRESHOLD=0.55

# -- API ----------------------------------------------------------------
# JSON list; default allows all origins
# QAROR_CORS_ORIGINS=["http://localhost:3000"]
