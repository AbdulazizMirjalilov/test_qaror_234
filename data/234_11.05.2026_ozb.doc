3" style="width: 820.5px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">________________________________________________________________________________________</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 820.5px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><sup><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">(jismoniy shaxsning shaxsiy identifikatsiya raqami)</span></span></span></sup></span></span></span></p></td></tr><tr><td colspan="3" style="width: 820.5px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p style="text-align:justify; text-indent:36.0pt"></p></td></tr><tr><td colspan="3" style="width: 820.5px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p style="text-align:justify; text-indent:36.0pt"><span style="font-size:11pt"><span style="text-justify:inter-ideograph"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">20___ yil ____ _____________dagi Imtihon komissiyasining qaroriga asosan ekologik ekspertiza obyektlari uchun loyiha hujjatlarini ishlab chiqishga doir malaka sertifikati berildi.</span></span></span></span></span></span></span></p></td></tr><tr><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="width: 1px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"></p></td></tr><tr><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">_________________________</span></span></span><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">_</span></span></span><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">___</span></span></span></span></span></span></p></td><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="width: 1px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">_________________</span></span></span></span></span></span></p></td></tr><tr><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><sup><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">(vakolatli shaxsning F.I.O.)</span></span></span></sup></span></span></span></p></td><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">(muhr oʻrni yoki QR-kod)</span></span></span></span></span></span></p></td><td style="width: 1px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><sup><span lang="UZ" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"><span style="color:black">(imzo)</span></span></span></sup></span></span></span></p></td></tr><tr><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="width:33%; padding:.100px .100px .100px 2px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="width: 1px; padding: 0.1px 0.1px 0.1px 2px; height: 19px; background-color: white;"><p align="center" style="text-align:center"></p></td></tr></tbody></table></div></div><div class="BY_DEFAULT"><div name="-8206088" id="-8206088"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8206089" id="-8206089">Vazirlar Mahkamasining 2026-yil 11-maydagi 234-son <a href="https://lex.uz/uz/docs/-8193120">qaroriga</a><br /> 8-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8206090" id="-8206090"><b>Strategik ekologik baholash boʻyicha ekologik maʼruzani tayyorlash va uning sifatini baholash tartibi toʻgʻrisida</b></div></div><div class="ACT_FORM"><div name="-8206091" id="-8206091">NIZOM</div></div><div class="BY_DEFAULT"><div name="-8206092" id="-8206092"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206093" id="-8206093"><b>1-bob. Umumiy qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8206094" id="-8206094">1. Ushbu Nizom Oʻzbekiston Respublikasining “Ekologik ekspertiza, atrof-muhitga taʼsirni baholash va strategik ekologik baholash toʻgʻrisida”gi <a href="https://lex.uz/uz/docs/-7397280">Qonuniga</a> muvofiq strategik ekologik baholash boʻyicha ekologik maʼruzani (keyingi oʻrinlarda — ekologik maʼruza) tayyorlash va uning sifatini baholash tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-8206095" id="-8206095">2. Ushbu Nizomda quyidagi asosiy tushunchalardan foydalaniladi:</div></div><div class="ACT_TEXT"><div name="-8206096" id="-8206096"><b>maxsus vakolatli davlat organi</b> — Oʻzbekiston Respublikasi Ekologiya va iqlim oʻzgarishi milliy qoʻmitasi;</div></div><div class="ACT_TEXT"><div name="-8206098" id="-8206098"><b>manfaatdor tomonlar</b> — strategik rejalashtirish hujjatlari loyihalari bilan bogʻliq faoliyatlarni qulay atrof-muhitga boʻlgan huquq va qonuniy manfaatlariga taʼsir koʻrsatishi mumkin boʻlgan jismoniy va (yoki) yuridik shaxslar;</div></div><div class="ACT_TEXT"><div name="-8206099" id="-8206099"><b>strategik rejalashtirish hujjatlari</b> — davlat dasturlarining, konsepsiyalarining, ishlab chiqarish kuchlarini, iqtisodiy va ijtimoiy sohalar tarmoqlarini joylashtirish hamda rivojlantirish sxemalarining loyihalari va shaharsozlik hujjatlari, shuningdek, boshqa strategik ahamiyatga ega boʻlgan obyektlarga oid hujjatlar;</div></div><div class="ACT_TEXT"><div name="-8206100" id="-8206100"><b>strategik ekologik baholash</b> — strategik rejalashtirish hujjatlari asosida moʻljallanayotgan va (yoki) rejalashtirilayotgan yoki amalga oshirilayotgan xoʻjalik faoliyatining hamda boshqa faoliyatning atrof-muhitga taʼsiri xususiyatlari va darajasini, ehtimoliy ekologik oqibatlarini aniqlashga, shuningdek, baholash natijalari boʻyicha atrof-muhitni muhofaza qilish hamda tabiiy resurslardan oqilona foydalanish chora-tadbirlarini ishlab chiqishga qaratilgan tartib-taomil;</div></div><div class="ACT_TEXT"><div name="-8206101" id="-8206101"><b>tashabbuskor</b> — strategik rejalashtirish hujjati loyihasini amalga oshirish uchun masʼul boʻlgan respublika va mahalliy ijro etuvchi hokimiyat organlari.</div></div><div class="ACT_TEXT"><div name="-8206102" id="-8206102">3. Strategik ekologik baholash obyektlari quyidagilardan iborat:</div></div><div class="ACT_TEXT"><div name="-8206103" id="-8206103">davlat dasturlarining, konsepsiyalarining, ishlab chiqarish kuchlarini, iqtisodiy va ijtimoiy soha tarmoqlarini joylashtirish hamda rivojlantirish sxemalarining loyihalari;</div></div><div class="ACT_TEXT"><div name="-8206104" id="-8206104">shaharsozlik hujjatlarining barcha turlari;</div></div><div class="ACT_TEXT"><div name="-8206105" id="-8206105">keyinchalik ularga muhofaza etiladigan tabiiy hududlar, favqulodda ekologik vaziyat va ekologik ofat zonalari maqomini berish maqsadida oʻtkazilgan hududlarni kompleks tekshirish materiallari, shuningdek, muhofaza etiladigan tabiiy hududlarni boshqarish rejalari loyihalari yuzasidan ishlab chiqilgan hujjatlar;</div></div><div class="ACT_TEXT"><div name="-8206106" id="-8206106">amalga oshirilishi atrof-muhitga salbiy taʼsir qilishi mumkin boʻlgan strategik rejalashtirish hujjatiga kiritilayotgan oʻzgartirish yoki qoʻshimchalar.</div></div><div class="ACT_TEXT"><div name="-8206107" id="-8206107">4. Oʻzbekiston Respublikasining mudofaasi, fuqaro muhofazasi, favqulodda vaziyatlar bilan bogʻliq strategik rejalashtirish hujjati loyihalari strategik ekologik baholanmaydi.</div></div><div class="ACT_TEXT"><div name="-8206108" id="-8206108">5. Strategik rejalashtirish hujjatini strategik ekologik baholamasdan tasdiqlash, amalga oshirish va unda nazarda tutilgan tadbirlarni moliyalashtirish taqiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8206109" id="-8206109">Bunda respublika (yuqori) darajasidagi hujjatlarni strategik ekologik baholash natijalari hududiy (quyi) darajadagi hujjatlar strategik ekologik baholashda hisobga olinishi va shuningdek, hududiy (quyi) darajalarda ishlab chiqilgan hujjatlarni strategik ekologik baholash natijalari respublika (yuqori) darajasida ishlab chiqilgan hujjatlar strategik ekologik baholashda hisobga olinishi kerak.</div></div><div class="ACT_TEXT"><div name="-8206110" id="-8206110">6. Strategik ekologik baholash quyidagi bosqichlardan iborat:</div></div><div class="ACT_TEXT"><div name="-8206111" id="-8206111">strategik rejalashtirish hujjati loyihasini dastlabki baholash;</div></div><div class="ACT_TEXT"><div name="-8206112" id="-8206112">ekologik maʼruzaning qamrov doirasini belgilash;</div></div><div class="ACT_TEXT"><div name="-8206113" id="-8206113">ekologik maʼruzani tayyorlash;</div></div><div class="ACT_TEXT"><div name="-8206114" id="-8206114">strategik rejalashtirish hujjati loyihasini strategik ekologik baholash doirasida manfaatdor tomonlar bilan maslahatlashuvlar oʻtkazish;</div></div><div class="ACT_TEXT"><div name="-8206115" id="-8206115">strategik rejalashtirish hujjati loyihasini strategik ekologik baholashda jamoatchilikning ishtirokini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8206116" id="-8206116">ekologik maʼruzaning sifatini baholash;</div></div><div class="ACT_TEXT"><div name="-8206117" id="-8206117">strategik ekologik baholash jarayonida strategik rejalashtirish hujjati loyihasining transchegaraviy taʼsirini baholash;</div></div><div class="ACT_TEXT"><div name="-8206118" id="-8206118">strategik rejalashtirish hujjatining atrof-muhitga taʼsirini monitoring qilish.</div></div><div class="ACT_TEXT"><div name="-8206119" id="-8206119">7. Strategik ekologik baholash ushbu jarayonning barcha bosqichlarida amalga oshirilishi lozim.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206120" id="-8206120"><b>2-bob. Strategik rejalashtirish hujjati loyihasini dastlabki baholash</b></div></div><div class="ACT_TEXT"><div name="-8206121" id="-8206121">8. Strategik rejalashtirish hujjati loyihasini strategik ekologik baholash zarurligi yoki zarur emasligini aniqlash maqsadida strategik rejalashtirish hujjati loyihasi dastlabki baholashdan (keyingi oʻrinlarda — dastlabki baholash) oʻtkazilishi lozim.</div></div><div class="ACT_TEXT"><div name="-8206122" id="-8206122">9. Dastlabki baholashni oʻtkazish uchun tashabbuskor maxsus vakolatli davlat organiga quyidagilarni taqdim etadi:</div></div><div class="ACT_TEXT"><div name="-8206123" id="-8206123">a) tashabbuskor haqidagi maʼlumotlar:</div></div><div class="ACT_TEXT"><div name="-8206124" id="-8206124">tashabbuskorning nomi, yuridik manzili, telefon raqamlari;</div></div><div class="ACT_TEXT"><div name="-8206125" id="-8206125">b) quyidagi maʼlumotlarni oʻz ichiga olgan strategik rejalashtirish hujjati loyihasining tushuntirish xati:</div></div><div class="ACT_TEXT"><div name="-8206126" id="-8206126">strategik rejalashtirish hujjati loyihasining nomi;</div></div><div class="ACT_TEXT"><div name="-8206127" id="-8206127">strategik rejalashtirish hujjati loyihasini ishlab chiqish zarurligini asoslash;</div></div><div class="ACT_TEXT"><div name="-8206128" id="-8206128">strategik rejalashtirish hujjati loyihasiga kiritilgan atrof-muhitni muhofaza qilishning asosiy jihatlari yoki dasturlar;</div></div><div class="ACT_TEXT"><div name="-8206129" id="-8206129">strategik rejalashtirish hujjati loyihasini amalga oshirishning asosiy yoʻnalishlari va muddatlari;</div></div><div class="ACT_TEXT"><div name="-8206130" id="-8206130">strategik rejalashtirish hujjati loyihasining amalga oshirilishi natijasida atrof-muhitga ehtimoliy taʼsiri;</div></div><div class="ACT_TEXT"><div name="-8206131" id="-8206131">strategik rejalashtirish hujjati loyihasini ishlab chiqish muddatlari va ularni tasdiqlash usuli;</div></div><div class="ACT_TEXT"><div name="-8206132" id="-8206132">hududning umumiy holati, tabiiy resurslar holati va ekologik xususiyatlari;</div></div><div class="ACT_TEXT"><div name="-8206133" id="-8206133">v) tegishli hudud toʻgʻrisidagi maʼlumotlar:</div></div><div class="ACT_TEXT"><div name="-8206134" id="-8206134">atrof-muhitga taʼsirni strategik ekologik baholashga mos keladigan tegishli hududni aniqlash;</div></div><div class="ACT_TEXT"><div name="-8206135" id="-8206135">hududning atrof-muhit holati hamda asosiy xususiyatlari va muammolari;</div></div><div class="ACT_TEXT"><div name="-8206136" id="-8206136">hududning tabiiy resurslardan foydalanish holati va rejalari;</div></div><div class="ACT_TEXT"><div name="-8206137" id="-8206137">muqobil rejalar;</div></div><div class="ACT_TEXT"><div name="-8206138" id="-8206138">baholanadigan obyektlar, ular koʻlami, baholash usullari.</div></div><div class="ACT_TEXT"><div name="-8206139" id="-8206139">g) manfaatdor tomonlarning strategik rejalashtirish hujjati loyihasi boʻyicha xulosalari.</div></div><div class="ACT_TEXT"><div name="-8206141" id="-8206141">Strategik rejalashtirish hujjati loyihasi maxsus vakolatli davlat organiga ijro intizomi nazoratini taʼminlovchi elektron hujjat aylanish tizimi orqali elektron shaklda taqdim etiladi.</div></div><div class="ACT_TEXT"><div name="-8206142" id="-8206142">10. Maxsus vakolatli davlat organi oʻn ish kuni ichida tashabbuskor tomonidan taqdim etilgan tegishli maʼlumotlarni dastlabki baholashdan oʻtkazadi va natijalari boʻyicha strategik ekologik baholash zarurligi yoki zarur emasligi toʻgʻrisida tegishli xulosa beradi.</div></div><div class="ACT_TEXT"><div name="-8206143" id="-8206143">11. Maxsus vakolatli davlat organi strategik ekologik baholash zarurligi aniqlangan strategik rejalashtirish hujjati loyihalari uchun manfaatdor tomonlar bilan maslahatlashuvlar oʻtkazish maqsadida ularning roʻyxatini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-8206144" id="-8206144">Bunda ushbu roʻyxatga sogʻliqni saqlash sohasidagi vakolatli organ, shuningdek, strategik rejalashtirish hujjati loyihasini amalga oshirish nazarda tutilayotgan maʼmuriy-hududiy birlikning mahalliy ijro etuvchi hokimiyat organi kiritilishi shart.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206145" id="-8206145"><b>3-bob. Strategik ekologik baholashda jamoatchilikning ishtirok etishi</b></div></div><div class="ACT_TEXT"><div name="-8206146" id="-8206146">12. Tashabbuskor tomonidan strategik ekologik baholash jarayonlari boʻyicha jamoatchilikni xabardor qilish hamda ularning faol ishtirokini taʼminlash maqsadida jamoatchilik eshituvlari tashkil etiladi.</div></div><div class="ACT_TEXT"><div name="-8206147" id="-8206147">Tashabbuskor jamoatchilik eshituvini oʻtkazish joyi va vaqti haqidagi maʼlumotlarni oʻzining va maxsus vakolatli davlat organining rasmiy veb-saytida, shuningdek, ommaviy axborot vositalarida va ijtimoiy tarmoqlarda jamoatchilik eshituvidan 15 kun oldin eʼlon beradi.</div></div><div class="ACT_TEXT"><div name="-8206148" id="-8206148">13. Jamoatchilik eshituvida tashabbuskor vakili tomonidan strategik rejalashtirish hujjati loyihasining texnik xususiyatga ega boʻlmagan maʼlumotlari taqdimot qilinadi.</div></div><div class="ACT_TEXT"><div name="-8206149" id="-8206149">14. Jamoatchilik eshituvi ommaviy va ochiq oʻtkaziladi. Jamoatchilik eshituvining ishtirokchilari jamoatchilik eshituviga kiritilgan masalalar yuzasidan oʻz fikrini erkin bildirishga va takliflar kiritishga haqli. Jamoatchilik eshituvi ommaviy axborot vositalari orqali va axborot-kommunikatsiya texnologiyalaridan foydalangan holda ham oʻtkazilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8206150" id="-8206150">15. Jamoatchilik eshituvi natijalari bayonnoma shaklida rasmiylashtiriladi.</div></div><div class="ACT_TEXT"><div name="-8206151" id="-8206151">16. Bayonnomada jamoatchilik eshituvlari natijalari, bildirilgan fikr va eʼtirozlar, manfaatdor tomonlarning takliflari, shuningdek, eshituvlar oʻtkazilgunga qadar kelib tushgan taklif va javoblar koʻrsatiladi.</div></div><div class="ACT_TEXT"><div name="-8206152" id="-8206152">17. Jamoatchilik eshituvi bayonnomasining har bir sahifasi yigʻilish raisi tomonidan imzolanadi hamda tashabbuskor tomonidan tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8206153" id="-8206153">18. Jamoatchilik eshituvi bayonnomalarining nusxalari tashabbuskorda kamida bir yil saqlanadi.</div></div><div class="ACT_TEXT"><div name="-8206154" id="-8206154">Jamoatchilik eshituvi bayonnomasi tashabbuskor veb-saytida eʼlon qilinishi va OAV orqali yoritib borilishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206155" id="-8206155"><b>4-bob. Strategik ekologik baholash boʻyicha ekologik maʼruzaning qamrov doirasini belgilash</b></div></div><div class="ACT_TEXT"><div name="-8206156" id="-8206156">19. Strategik ekologik baholash boʻyicha ekologik maʼruzaning qamrov doirasi maxsus vakolatli davlat organi tomonidan besh ish kuni ichida belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8206157" id="-8206157">Ekologik maʼruzaning qamrov doirasini belgilashda strategik rejalashtirish hujjati loyihasining tavsifi va mazmunidan kelib chiqib, ekologik maʼruzaga kiritiladigan axborotning hajmi, toʻliqligi va batafsilligi darajasi aniqlanadi.</div></div><div class="ACT_TEXT"><div name="-8206158" id="-8206158">Ekologik maʼruzaning qamrov doirasi quyidagi maqsadlarda belgilanadi:</div></div><div class="ACT_TEXT"><div name="-8206159" id="-8206159">strategik rejalashtirish hujjati loyihasiga kiritilishi mumkin boʻlgan, asoslantirilgan va amalda qoʻllanadigan muqobil yechimlarni belgilash, shu jumladan, atrof-muhitga va (yoki) inson sogʻligʻiga taʼsirni kamaytirish;</div></div><div class="ACT_TEXT"><div name="-8206160" id="-8206160">strategik rejalashtirish hujjati loyihasi, shuningdek, unga kiritilishi mumkin boʻlgan oʻzgartirishlar, uni amalga oshirishdan kutilayotgan natijalar haqida jamoatchilikni xabardor qilish;</div></div><div class="ACT_TEXT"><div name="-8206161" id="-8206161">strategik rejalashtirish hujjati loyihasining muhofaza etiladigan tabiiy hududlarga hamda qonunchilikka va Oʻzbekiston Respublikasining xalqaro shartnomalar boʻyicha majburiyatlariga muvofiq muhofaza etilishi lozim boʻlgan mahalliy, davlat ahamiyatiga hamda xalqaro ahamiyatga ega boʻlgan boshqa hududlarga va obyektlarga jiddiy salbiy taʼsirini aniqlash;</div></div><div class="ACT_TEXT"><div name="-8206162" id="-8206162">strategik rejalashtirish hujjati loyihasini amalga oshirishda atrof-muhitga transchegaraviy taʼsir ehtimolini aniqlash;</div></div><div class="ACT_TEXT"><div name="-8206163" id="-8206163">inson sogʻligʻini va qulay atrof-muhitni taʼminlash uchun strategik rejalashtirish hujjati loyihasini amalga oshirish bilan bogʻliq boʻlgan atrof-muhitni muhofaza qilish sohasidagi maqsadlarni, shu jumladan, xalqaro va milliy darajada belgilangan maqsadlarni aniqlash.</div></div><div class="ACT_TEXT"><div name="-8206164" id="-8206164">20. Ekologik maʼruzaning qamrov doirasini belgilashda quyidagi atrof-muhit obyektlarini oʻz ichiga olishi kerak:</div></div><div class="ACT_TEXT"><div name="-8206165" id="-8206165">a) atrof-muhitni muhofaza qilish va tabiiy resurslardan oqilona foydalanish, shu jumladan:</div></div><div class="ACT_TEXT"><div name="-8206166" id="-8206166">chiqindilar bilan bogʻliq ishlarni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-8206167" id="-8206167">yer qaʼrini muhofaza qilish va undan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8206168" id="-8206168">muhofaza etiladigan tabiiy hududlar kengaytirish va ularning muhofazasi;</div></div><div class="ACT_TEXT"><div name="-8206170" id="-8206170">hududlarda barqaror radiatsiyaviy vaziyatni saqlash;</div></div><div class="ACT_TEXT"><div name="-8206171" id="-8206171">gidrometeorologik sharoitlar tavsifi;</div></div><div class="ACT_TEXT"><div name="-8206172" id="-8206172">yerni (shu jumladan, tuproqni) muhofaza qilish va undan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8206173" id="-8206173">oʻrmonlardan foydalanish, muhofaza qilish, saqlash va koʻpaytirish;</div></div><div class="ACT_TEXT"><div name="-8206174" id="-8206174">suvni muhofaza qilish va undan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8206175" id="-8206175">hayvonot dunyosini muhofaza qilish va undan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8206176" id="-8206176">oʻsimlik dunyosini muhofaza qilish va undan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8206177" id="-8206177">atmosfera havosini himoya qilish;</div></div><div class="ACT_TEXT"><div name="-8206178" id="-8206178">ozon qatlamini himoya qilish;</div></div><div class="ACT_TEXT"><div name="-8206179" id="-8206179">b) qishloq va oʻrmon xoʻjaliklari tarmoqlari;</div></div><div class="ACT_TEXT"><div name="-8206180" id="-8206180">v) sanoat, shu jumladan, uning alohida tarmoqlari;</div></div><div class="ACT_TEXT"><div name="-8206181" id="-8206181">g) transport, shu jumladan, xavfli yuklarni tashish, temir yoʻl transporti, ichki suv transporti, havo transporti, avtomobil transporti, avtomobil yoʻllari, harakat xavfsizligi;</div></div><div class="ACT_TEXT"><div name="-8206182" id="-8206182">d) energiya, shu jumladan, atom energiyasidan foydalanish boʻyicha faoliyat, energiya taʼminoti, elektr energiyasi, issiqlik energiyasi, qayta tiklanuvchi energiya manbalari.</div></div><div class="ACT_TEXT"><div name="-8206183" id="-8206183">21. Qamrov doirasini aniqlashda strategik rejalashtirish hujjati loyihasini amalga oshirishning muqobil variantlari hisobga olinishi kerak.</div></div><div class="ACT_TEXT"><div name="-8206184" id="-8206184">Muqobil variantlar tegishli tashkiliy, ilmiy, texnik rivojlanish bilan, shuningdek, hududiy mansublik nuqtai nazaridan amalga oshirish imkoniyatlariga mos kelishi kerak.</div></div><div class="ACT_TEXT"><div name="-8206185" id="-8206185">Salbiy oqibatlarga olib keladigan strategik rejalashtirish hujjatini amalga oshirishning muqobil variantlaridan foydalanishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-8206186" id="-8206186">22. Respublika va mahalliy ijro etuvchi hokimiyat organlari tashabbuskordan strategik rejalashtirish hujjati loyihasini barcha bosqichlarida fuqarolarning obyektiv ekologik maʼlumotni oʻz vaqtida olish va atrof-muhit bilan bogʻliq masalalar boʻyicha qarorlar qabul qilishda jamoatchilik ishtiroki huquqini amalga oshirishni taʼminlaydi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206187" id="-8206187"><b>5-bob. Ekologik maʼruzani tayyorlash tartibi</b></div></div><div class="ACT_TEXT"><div name="-8206188" id="-8206188">23. Strategik rejalashtirish hujjati loyihasini amalga oshirish uchun tashabbuskor ekologik maʼruzani tayyorlaydi va uning sifatini baholash uchun maxsus vakolatli davlat organiga taqdim etadi.</div></div><div class="ACT_TEXT"><div name="-8206189" id="-8206189">Ekologik maʼruzada keltirilgan maʼlumotlarning ishonchligi va toʻliqligiga tashabbuskor javobgar hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8206190" id="-8206190">24. Tashabbuskor ekologik maʼruzani tayyorlash uchun qonunchilikda belgilangan tartibda loyihani ishlab chiquvchi tashkilotlarni, mahalliy va xorijiy malakali mutaxassislar va tashqi ekspertlarni jalb qilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8206191" id="-8206191">25. Ekologik maʼruza quyidagilarni oʻz ichiga olishi lozim:</div></div><div class="ACT_TEXT"><div name="-8206192" id="-8206192">strategik rejalashtirish hujjati loyihasining nomi va loyiha haqida maʼlumotlar;</div></div><div class="ACT_TEXT"><div name="-8206193" id="-8206193">strategik ekologik baholashning maqsad va vazifalari, uni oʻtkazishga qoʻyiladigan talablar, agar u oʻtkazilgan boʻlsa, dastlabki baholash natijalari;</div></div><div class="ACT_TEXT"><div name="-8206194" id="-8206194">ishlab chiqilayotgan hujjat yangimi yoki mavjud yechimga oʻzgartirish va (yoki) qoʻshimchalar kiritilayotgani toʻgʻrisidagi maʼlumotlarni koʻrsatgan holda, taklif etilayotgan strategik qarorlar tavsifi bilan strategik rejalashtirish hujjati loyihasining tavsifi;</div></div><div class="ACT_TEXT"><div name="-8206195" id="-8206195">strategik ekologik baholashda ishtirok etganlarning shaxsiy maʼlumotlari;</div></div><div class="ACT_TEXT"><div name="-8206196" id="-8206196">strategik rejalashtirish hujjati loyihasining boshqa amaldagi strategik rejalashtirish hujjati loyihasiga muvofiqligi toʻgʻrisidagi maʼlumotlar;</div></div><div class="ACT_TEXT"><div name="-8206197" id="-8206197">boshqa strategik rejalashtirish hujjati loyihasining mumkin boʻlgan taʼsiri;</div></div><div class="ACT_TEXT"><div name="-8206198" id="-8206198">strategik rejalashtirish hujjati loyihasini ishlab chiqish va tasdiqlash muddatlari;</div></div><div class="ACT_TEXT"><div name="-8206199" id="-8206199">atrof-muhit komponentlari holatini tavsiflash;</div></div><div class="ACT_TEXT"><div name="-8206201" id="-8206201">strategik rejalashtirish hujjati loyihasini amalga oshirishning mumkin boʻlgan muqobil variantlari, ularni koʻrib chiqish va dasturlar loyihasini ishlab chiqishda hisobga olish zarurati;</div></div><div class="ACT_TEXT"><div name="-8206202" id="-8206202">strategik rejalashtirish hujjati loyihasini amalga oshirish jarayonida atrof-muhitga taʼsir qilish jihatlarini baholash;</div></div><div class="ACT_TEXT"><div name="-8206203" id="-8206203">strategik rejalashtirish hujjati loyihasini amalga oshirish jarayonida ekologik jihatlarga taʼsir etuvchi taʼsirning ijtimoiy-iqtisodiy jihatlarini baholash;</div></div><div class="ACT_TEXT"><div name="-8206204" id="-8206204">strategik rejalashtirish hujjati loyihasini amalga oshirishning aholi salomatligiga taʼsirini baholash;</div></div><div class="ACT_TEXT"><div name="-8206205" id="-8206205">tavsiya etilgan strategik qarorni tanlashni asoslash;</div></div><div class="ACT_TEXT"><div name="-8206206" id="-8206206">strategik rejalashtirish hujjati loyihasini amalga oshirish jarayonida yuzaga kelishi mumkin boʻlgan atrof-muhitga (shu jumladan, transchegaraviy) taʼsir va ekologik oʻzgarishlarni aniqlash;</div></div><div class="ACT_TEXT"><div name="-8206207" id="-8206207">strategik rejalashtirish hujjati loyihasini amalga oshirish samaradorligini monitoring qilish rejasi;</div></div><div class="ACT_TEXT"><div name="-8206208" id="-8206208">manfaatdor tomonlar hamda jamoatchilik bilan kelishuv toʻgʻrisidagi maʼlumotlar;</div></div><div class="ACT_TEXT"><div name="-8206209" id="-8206209">strategik ekologik baholash tavsiyalarini strategik rejalashtirish hujjati loyihasini ishlab chiqishga integratsiya qilish boʻyicha takliflar;</div></div><div class="ACT_TEXT"><div name="-8206210" id="-8206210">foydalanilgan adabiy manbalar.</div></div><div class="ACT_TEXT"><div name="-8206211" id="-8206211">Tashabbuskor ekologik maʼruzani tayyorlash doirasida manfaatdor respublika va mahalliy ijro etuvchi hokimiyat organlari bilan maslahatlashishga haqlidir.</div></div><div class="ACT_TEXT"><div name="-8206212" id="-8206212">26. Tashabbuskor tomonidan strategik rejalashtirish hujjati loyihasini tayyorlashda jamoatchilik muhokamasi hamda respublika va mahalliy ijro etuvchi hokimiyat organlari bilan maslahatlashuvlar yakunlari boʻyicha bildirilgan asosli takliflar hisobga olinadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206213" id="-8206213"><b>6-bob. Ekologik maʼruzaning sifatini baholash tartibi</b></div></div><div class="ACT_TEXT"><div name="-8206214" id="-8206214">27. Strategik ekologik baholash maxsus vakolatli davlat organi tomonidan quyidagi mezonlarga asosan oʻtkaziladi:</div></div><div class="ACT_TEXT"><div name="-8206215" id="-8206215">strategik rejalashtirish hujjati loyihasining atrof-muhitga taʼsiri bilan bogʻliq ekologik xavflarning hisobga olinishini taʼminlash va mazkur hujjatning barqaror rivojlanishga koʻmaklashish maqsadlariga muvofiqligini taʼminlash zarurligi nuqtai nazaridan dolzarbligi;</div></div><div class="ACT_TEXT"><div name="-8206216" id="-8206216">barqaror rivojlanishga koʻmaklashishni taʼminlash maqsadida strategik rejalashtirish hujjati loyihasida aholi sogʻligʻi bilan bogʻliq ekologik omillarni hisobga olish zarurligi;</div></div><div class="ACT_TEXT"><div name="-8206217" id="-8206217">strategik rejalashtirish hujjati loyihasini faoliyat turlarini, ularning joylashuvini, koʻlamlarini, sharoitlarini hamda tabiiy resurslarning mavjudligini va ulardan foydalanish shartlarini hisobga olgan holda amalga oshirish imkoniyati;</div></div><div class="ACT_TEXT"><div name="-8206218" id="-8206218">strategik rejalashtirish hujjati loyihasini amalga oshirish jarayonida ekologik xavflarning, shu jumladan, inson sogʻligiga taʼsirning hisobga olinishi;</div></div><div class="ACT_TEXT"><div name="-8206219" id="-8206219">strategik rejalashtirish hujjati loyihasining atrof-muhitni muhofaza qilish va tabiiy resurslardan oqilona foydalanish sohasidagi qonunchilik talablarini hamda Oʻzbekiston Respublikasining atrof-muhitni muhofaza qilish sohasidagi xalqaro majburiyatlarini bajarish nuqtai nazaridan dolzarbligi;</div></div><div class="ACT_TEXT"><div name="-8206220" id="-8206220">strategik rejalashtirish hujjati loyihasiga kiritilayotgan oʻzgartirishlar va (yoki) qoʻshimchalar bilan bogʻliq ekologik muammolarning, shu jumladan, aholi sogʻligʻi bilan bogʻliq muammolarning mavjudligi;</div></div><div class="ACT_TEXT"><div name="-8206221" id="-8206221">strategik rejalashtirish hujjati loyihasini amalga oshirish jarayonida yuzaga keladigan ehtimol tutilgan oqibatlarning transchegaraviy xususiyati.</div></div><div class="ACT_TEXT"><div name="-8206222" id="-8206222">Maxsus vakolatli davlat organi strategik rejalashtirish hujjati loyihasini ushbu bandning <a href="https://lex.uz/uz/docs/-8193120#-8206214">birinchi qismida</a> nazarda tutilgan mezonlarga asosan strategik ekologik baholaydi hamda tegishli tavsiyalarni beradi.</div></div><div class="ACT_TEXT"><div name="-8206223" id="-8206223">28. Maxsus vakolatli davlat organi maʼruza sifatini baholashda zarur hollarda xulosalari tavsiya xususiyatiga ega boʻlgan mahalliy hamda xorijiy malakali mutaxassislar va ekspertlarni shartnoma asosida oʻz mablagʻlari hisobidan qonunchilikda belgilangan tartibda jalb etishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8206224" id="-8206224">29. Tashabbuskor maxsus vakolatli davlat organiga maʼruza sifatini baholash doirasida zarur boʻlgan axborotlarni taqdim etishi shart.</div></div><div class="ACT_TEXT"><div name="-8206225" id="-8206225">30. Maxsus vakolatli davlat organi manfaatdor tomonlar hamda jamoatchilikdan olingan fikr va takliflarni hisobga olgan holda, maʼruza sifatini baholaydi.</div></div><div class="ACT_TEXT"><div name="-8206226" id="-8206226">Maʼruza sifati atrof-muhitni muhofaza qilish va tabiiy resurslardan oqilona foydalanish sohasidagi normativ-huquqiy hujjatlar hamda ekologik normativlar asosida baholanadi.</div></div><div class="ACT_TEXT"><div name="-8206227" id="-8206227">31. Maʼruza sifatini baholash natijalariga koʻra maxsus vakolatli davlat organi oʻn besh ish kuni ichida ekologik maʼruzaning sifati toʻgʻrisida tegishli xulosa chiqaradi.</div></div><div class="ACT_TEXT"><div name="-8206228" id="-8206228">32. Maxsus vakolatli davlat organi ekologik maʼruzani baholash natijalari boʻyicha tayyorlagan ekologik xulosani tashabbuskorga ikki ish kuni ichida rasman yuboradi.</div></div><div class="ACT_TEXT"><div name="-8206229" id="-8206229">33. Ekologik maʼruzani baholash yakunlari boʻyicha berilgan har bir ekologik xulosa maxsus vakolatli davlat organining rasmiy veb-saytida joylashtiriladi.</div></div><div class="ACT_TEXT"><div name="-8206230" id="-8206230">34. Strategik ekologik baholash har bir strategik ekologik baholash obyekti boʻyicha bir marta oʻtkaziladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206232" id="-8206232"><b>7-bob. Manfaatdor tomonlar bilan maslahatlashuvlar oʻtkazish</b></div></div><div class="ACT_TEXT"><div name="-8206233" id="-8206233">35. Tashabbuskor strategik rejalashtirish hujjati loyihasini strategik ekologik baholash doirasida manfaatdor tomonlar bilan maslahatlashuvlar oʻtkazadi.</div></div><div class="ACT_TEXT"><div name="-8206234" id="-8206234">36. Tashabbuskor manfaatdor tomonlar soʻroviga asosan strategik ekologik baholash doirasida tegishli maʼlumotlarni taqdim etishi shart.</div></div><div class="ACT_TEXT"><div name="-8206235" id="-8206235">37. Manfaatdor tomonlar strategik rejalashtirish hujjati loyihasi boʻyicha oʻz mulohazalari va takliflarini yoxud ularning mavjud emasligi toʻgʻrisidagi maʼlumotni tashabbuskorga qonunchilikda belgilangan muddatlarda taqdim etishi shart.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206236" id="-8206236"><b>8-bob. Strategik ekologik baholash jarayonida strategik rejalashtirish hujjati loyihasining transchegaraviy taʼsirini baholash</b></div></div><div class="ACT_TEXT"><div name="-8206237" id="-8206237">38. Strategik rejalashtirish hujjati loyihasi transchegaraviy jihatdan quyidagi hollarda baholanadi:</div></div><div class="ACT_TEXT"><div name="-8206238" id="-8206238">agar Oʻzbekiston Respublikasi hududida moʻljallanayotgan va (yoki) rejalashtirilayotgan yoki amalga oshirilayotgan xoʻjalik faoliyati hamda boshqa faoliyat qoʻshni davlat hududida atrof-muhitga sezilarli salbiy taʼsir qilishi mumkin boʻlsa;</div></div><div class="ACT_TEXT"><div name="-8206239" id="-8206239">agar qoʻshni davlatda moʻljallanayotgan va (yoki) rejalashtirilayotgan yoki amalga oshirilayotgan xoʻjalik faoliyati hamda boshqa faoliyat Oʻzbekiston Respublikasi hududida atrof-muhitga sezilarli salbiy taʼsir koʻrsatayotgan boʻlsa.</div></div><div class="ACT_TEXT"><div name="-8206240" id="-8206240">39. Atrof-muhitga taʼsir Oʻzbekiston Respublikasining qonunchiligiga muvofiq transchegaraviy jihatdan baholanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206241" id="-8206241"><b>9-bob. Strategik rejalashtirish hujjatining atrof-muhitga taʼsirini monitoring qilish</b></div></div><div class="ACT_TEXT"><div name="-8206242" id="-8206242">40. Ekologik maʼruzaning sifati toʻgʻrisidagi xulosada koʻrsatilgan talablarni taʼminlashga qaratilgan chora-tadbirlarni amalga oshirish va monitoring qilish belgilangan tartibda tashabbuskor tomonidan taʼminlanadi.</div></div><div class="ACT_TEXT"><div name="-8206243" id="-8206243">Tashabbuskor ekologik maʼruzaning sifati toʻgʻrisidagi xulosada koʻrsatilgan talablarning bajarilishi toʻgʻrisida har chorak yakunlariga koʻra chorakdan keyingi oyning 25-sanasidan kechiktirmay maxsus vakolatli davlat organiga axborot taqdim etishi shart.</div></div><div class="ACT_TEXT"><div name="-8206244" id="-8206244">Bunda tashabbuskor xulosada koʻrsatilgan talablarning bajarilishi toʻgʻrisidagi axborotni ushbu bandning <a href="https://lex.uz/uz/docs/-8193120#-8206243">ikkinchi xatboshisida</a> nazarda tutilgan muddatlarda taqdim etmagan taqdirda, maxsus vakolatli davlat organiga tashabbuskorga yozma koʻrsatma beradi.</div></div><div class="ACT_TEXT"><div name="-8206245" id="-8206245">41. Tashabbuskor tegishli strategik rejalashtirish hujjatini amalga oshirish jarayonida atrof-muhit yoki aholi salomatligi uchun salbiy oqibatlarga olib kelishini aniqlasa, bunday oqibatlarning oldini olish yoki yumshatish boʻyicha choralar koʻrilishini taʼminlashi, bu haqida maxsus vakolatli davlat organi va tegishli tashkilotlarni xabardor qilishi shart.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8206246" id="-8206246"><b>10-bob. Yakunlovchi qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8206247" id="-8206247">42. Ushbu Nizomni qoʻllashda yuzaga keladigan nizolar qonunchilik hujjatlarida belgilangan tartibda hal etiladi.</div></div><div class="ACT_TEXT"><div name="-8206248" id="-8206248">43. Mazkur Nizom talablari buzilishida aybdor boʻlgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javobgar boʻladilar.</div></div><div class="BY_DEFAULT"><div name="-8206440" id="-8206440"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8206441" id="-8206441">Strategik ekologik baholash boʻyicha ekologik maʼruzani tayyorlash va uning sifatini baholash tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8193120#-8206090">nizomga</a><br />ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8206442" id="-8206442">Strategik ekologik baholash boʻyicha ekologik maʼruzani tayyorlash va uning sifatini baholash tartibi</div></div><div class="ACT_FORM"><div name="-8206443" id="-8206443">SXEMASI</div></div><div class="BY_DEFAULT"><div name="-8206446" id="-8206446"></div></div><div class="TABLE_STD2"><div name="-8206532" id="-8206532"><table class="Table" style="width:100.0%; border-collapse:collapse" width="100%"><tbody><tr><td rowspan="2" style="border-bottom:1px solid black; width:10%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Bosqichlar</span></span></b></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Subyektlar</span></span></b></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:44%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Tadbirlar</span></span></b></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Bajarish muddatlari</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:10%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:44%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:10%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1-bosqich</span></span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Respublika va mahalliy ijro etuvchi hokimiyat organlari</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(keyingi oʻrinlarda — tashabbuskor)</span></span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:44%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p style="text-align:justify; text-indent:16.25pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Strategik rejalashtirish hujjati loyihasini Ekologiya qoʻmitasiga ijro intizomi nazoratini taʼminlovchi elektron hujjat aylanish tizimi orqali elektron shaklda taqdim etadi.</span></span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Zaruratga koʻra</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:10%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:44%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p style="text-align:justify; text-indent:16.25pt"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:10%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2-bosqich</span></span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ekologiya qoʻmitasi</span></span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:44%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p style="text-align:justify; text-indent:16.25pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Tashabbuskor tomonidan taqdim etilgan tegishli maʼlumotlarni dastlabki baholash natijalariga koʻra strategik ekologik baholash zarurligi yoki zarur emasligi toʻgʻrisida xulosa beradi.</span></span></span></span></span></p></td><td style="border-bottom:none; width: