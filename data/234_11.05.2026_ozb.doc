gn:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Avtomobil sporti majmualari, avtopoyga trassalari va yoʻlaklari.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td colspan="4" style="border-bottom:1px solid black; width:100%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2. Energetika sanoati</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">136.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:59%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Bioreaktor sigʻimi 100 m<sup>3</sup>gacha boʻlgan biogaz qurilmalari (shaxsiy ehtiyojlar uchun biogaz ishlab chiqarish bundan mustasno).</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">137.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:59%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">35 kVt gacha kuchlanishga ega boʻlgan (havo va kabel) elektr uzatish liniyalari, shu jumladan, transformator stansiyalari (podstansiyalar).</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">138.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:59%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Quvvati 100 MVtgacha boʻlgan issiqlik elektr stansiyalari va boshqa energetik yondirish qurilmalari.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px s