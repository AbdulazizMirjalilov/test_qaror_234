; padding:0cm 7px 0cm 7px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:22%; padding:0cm 7px 0cm 7px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:14%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2-bosqich</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:29%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Xatlovdan oʻtkazish materiallarini tasdiqlash va tashkilot joylashgan joy boʻyicha Qoraqalpogʻiston Respublikasi Ekologiya va iqlim oʻzgarishi qoʻmitasiga, viloyatlar va Toshkent shahar ekologiya va iqlim oʻzgarishi bosh boshqarmalariga yuborish</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:25%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Tashkilot rahbari</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:22%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Tayyorligiga koʻra</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:14%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:29%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:25%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:22%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:14%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3-bosqich</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:29%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Atrof-muhitni ifloslantiruvchi manbalarni oʻrgangan holda, xatlovdan oʻtkazish materiallarini koʻrib chiqish va ularni tasdiqlash yoki qayta ishlash uchun qaytarish (ishonchsiz maʼlumotlar aniqlanganda)</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:25%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Obyekt joylashgan joy boʻyicha Qoraqalpogʻiston Respublikasi ekologiya va iqlim oʻzgarishi qoʻmitasi, viloyatlar va Toshkent shahar ekologiya va iqlim oʻzgarishi bosh boshqarmalari</span></span></span></span></span></p></td><td style="border-bottom:none; width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:22%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Taqdim qilingan kunidan boshlab 15 kun mobaynida</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:14%; padding:0cm 7px 0cm 7px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" style="text-align:center"></p></td><td style="width:2%; padding:0cm 7px 0cm 7px; height:19px; background-color:white"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:29%; padding:0cm 7px 0cm 7px; height:19px; background-color:white; border-top:none; bor