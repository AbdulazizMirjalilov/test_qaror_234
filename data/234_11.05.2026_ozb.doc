white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Xom gʻisht, shlakoblok, yoʻlak plitkalari, penoblok va gazobloklar ishlab chiqarish korxonalari.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">167.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:59%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Qurilishda foydalaniladigan pardozlash materiallarini ishlab chiqarish, shuningdek, ohak, gips, shpaklevka va boʻr ishlab chiqarish korxonalari (keramik plita va sanitariya texnik vositalar ishlab chiqarish bundan mustasno)..</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">168.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:59%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Shisha, keramika va kulolchilik mahsulotlarini ishlab chiqaruvchi hunarmandchilik korxonalar.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:21%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15</span></span></span></span></span></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7,5</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:4%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">169.</span></span></span></span></span></p></td