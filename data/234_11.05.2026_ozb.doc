19px; background-color: white;" valign="top"><p align="center" style="text-align: center;"></p></td></tr><tr><td colspan="2" style="border-bottom: 1px solid black; width: 25%; padding: 0cm 4px 0cm 4px; height: 19px; background-color: white; border-top: none; border-right: 1px solid black; border-left: 1px solid black;" valign="top"><p align="center" style="text-align: center;"></p></td><td colspan="3" style="border-bottom: 1px solid black; width: 25%; padding: 0cm 4px 0cm 4px; height: 19px; background-color: white; border-top: none; border-right: 1px solid black; border-left: none;" valign="top"><p align="center" style="text-align: center;"></p></td><td colspan="4" style="border-bottom: 1px solid black; width: 25%; padding: 0cm 4px 0cm 4px; height: 19px; background-color: white; border-top: none; border-right: 1px solid black; border-left: none;" valign="top"><p align="center" style="text-align: center;"></p></td><td colspan="3" style="border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor black black currentcolor; width: 108px; padding: 0cm 4px; height: 19px; background-color: white;" valign="top"><p align="center" style="text-align: center;"></p></td></tr><tr><td colspan="5" style="width: 50%; padding: 0cm 4px 0cm 4px; height: 19px; background-color: white; border: none;" valign="top"><p align="center" style="text-align: center;"></p></td><td colspan="7" style="width: 319px; padding: 0cm 4px; height: 19px; background-color: white; border: medium none currentcolor;" valign="top"><p align="center" style="text-align: center;"></p></td></tr><tr><td colspan="12" style="width: 806px; padding: 0cm 4px; height: 19px; background-color: white;" valign="top"><p align="center" style="text-align: center;"><span style="font-size: 11pt;"><span style="line-height: normal;"><span style="text-autospace: ideograph-numeric;"><span style="font-family: Calibri,sans-serif;"><span lang="UZ-CYR" style="font-size: 12.0pt;"><span style="font-fam